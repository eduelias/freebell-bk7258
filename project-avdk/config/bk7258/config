CONFIG_OVERRIDE_FLASH_PARTITION=y
CONFIG_PSRAM_AUTO_DETECT=n
CONFIG_PSRAM_APS128XXO_OB9=y
CONFIG_PSRAM_WRITE_THROUGH=y
CONFIG_SYS_CPU1_OFFSET=0x21b0000
CONFIG_AUDIO=y
CONFIG_AUDIO_ADC=y
CONFIG_AUDIO_DAC=y
CONFIG_AUDIO_TEST=y
CONFIG_TRANS_APP_TASK_SIZE=2048
CONFIG_CPU0_SPE_RAM_SIZE=0X55000
CONFIG_CPU1_APP_RAM_SIZE=0x3F800
CONFIG_CPU2_APP_RAM_SIZE=0XB800
CONFIG_BT_REUSE_MEDIA_MEMORY=y
CONFIG_BT_REUSE_MEDIA_MEM_SIZE=0x1B000
CONFIG_I2S=n
CONFIG_DMA_LOGIC_CHAN_ID_MIN=0
# camera helpers on CPU0 too (video_common_driver: power/MCLK/GPIO) for `cam probe`; the pipeline itself runs on CPU1
CONFIG_JPEGENC_HW=y
CONFIG_YUV_BUF=y
CONFIG_H264=y
CONFIG_DVP_CAMERA=y
CONFIG_DVP_CAMERA_TEST=n
# microSD (feature sd): the SDK's power-GPIO helper would drive GPIO 13 (SDCARD_LDO_CTRL_GPIO) and
# power the card down from a timer after 10 s idle; sdcard.c drives the real power pin (GPIO 6) itself
CONFIG_SDCARD_POWER_GPIO_CTRL=n
