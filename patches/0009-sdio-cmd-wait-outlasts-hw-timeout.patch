 #define SDIO_MAX_TX_WAIT_TIME (512)
 #define SDIO_MAX_RX_WAIT_TIME (512)
-#define SDIO_CMD_WAIT_TIME    (4)	//one cycle:try 128 counts
+/* doorbell-bk7258-fw: the software wait must outlast the hardware response timeout (2500 clocks at
+ * the 100 kHz init speed = 25 ms), otherwise a late response is queued by the ISR after the caller
+ * gave up and the next command pops that stale message (every later wait "succeeds" or "times out"
+ * out of step until the driver is re-initialised). Was 4 ms. */
+#define SDIO_CMD_WAIT_TIME    (30)	//one cycle:try 128 counts
 #define SDIO_BLOCK_SIZE (0x200)
