+			value[0] = '\0';
+			n = 2;
+		}
 		if (n == 2) {
 			log_debug("Read header : %s: %s", key, value);
 			if (!os_strcmp(key, "Content-Length")) {
@@ -1191,8 +1197,10 @@ int httpclient_response_parse(httpclient_t *client, char *data, int len, uint32_
 			len -= (crlf_pos + 2);
 
 		} else {
-			log_err("Could not parse header");
-			return ERROR_HTTP;
+			/* doorbell-bk7258-fw: skip lines we cannot parse instead of aborting */
+			log_err("Could not parse header, skipping");
+			os_memmove(data, &data[crlf_pos + 2], len - (crlf_pos + 2) + 1);
+			len -= (crlf_pos + 2);
 		}
 	}
 
