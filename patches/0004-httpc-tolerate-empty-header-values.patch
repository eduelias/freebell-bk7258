diff --git a/components/http/utils_httpc.c b/components/http/utils_httpc.c
index 00fe3c3a..28b9b639 100755
--- a/components/http/utils_httpc.c
+++ b/components/http/utils_httpc.c
@@ -1175,6 +1175,12 @@ int httpclient_response_parse(httpclient_t *client, char *data, int len, uint32_
 		data[crlf_pos] = '\0';
 
 		n = sscanf(data, "%31[^:]: %31[^\r\n]", key, value);
+		if (n == 1) {
+			/* doorbell-bk7258-fw: tolerate headers with an empty value, e.g. "Server: " as sent
